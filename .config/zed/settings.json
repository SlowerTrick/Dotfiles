// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Git integration settings
  "show_edit_predictions": true,
  "proxy": "",
  "disable_ai": false,
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enabled": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
    "show": true
  },
  "search": {
    "button": true
  },
  "status_bar": {
    "line_endings_button": false,
    "cursor_position_button": false,
    "active_language_button": true
  },
  "languages": {
    "Python": {
      "completions": {
        "lsp": true
      },
      "word_diff_enabled": true,
      "tasks": {
        "prefer_lsp": true,
        "enabled": true
      },
      "enable_language_server": true,
      "inlay_hints": {
        "show_background": false,
        "enabled": false
      }
    }
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true
    }
  },
  "colorize_brackets": false,
  "inlay_hints": {
    "enabled": false
  },
  "cursor_blink": false,
  "vim": {
    "gdefault": true,
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },
  "relative_line_numbers": "disabled",
  "git": {
    "disable_git": false,
    "inline_blame": {
      "location": "status_bar",
      "enabled": true
    }
  },

  // Icon theme
  "icon_theme": "Warm Charmed Icons",

  // Side panels and docks placement (docked to left)
  "outline_panel": {
    "button": true,
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "git_panel": {
    "show_count_badge": false,
    "file_icons": true,
    "collapse_untracked_diff": false,
    "tree_view": true,
    "dock": "left"
  },
  "debugger": {
    "dock": "left"
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false
    },
    "default_height": 360.0,
    "copy_on_select": true,
    "shell": "system",
    "show_count_badge": false,
    "flexible": true,
    "button": true,
    "dock": "bottom"
  },
  "project_panel": {
    "indent_guides": {
      "show": "always"
    },
    "git_status_indicator": false,
    "diagnostic_badges": false,
    "auto_fold_dirs": true,
    "starts_open": true,
    "auto_reveal_entries": true,
    "indent_size": 20.0,
    "git_status": true,
    "folder_icons": true,
    "file_icons": true,
    "entry_spacing": "comfortable",
    "default_width": 300.0,
    "button": true,
    "dock": "left",
    "hide_root": true,
    "sticky_scroll": false
  },

  // AI Assistant / Agent panel placement
  "agent": {
    "button": true,
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },

  // Enable key binding hints popup
  "which_key": {
    "delay_ms": 0,
    "enabled": true
  },

  // Autosave after 1 second of inactivity
  "autosave": {
    "after_delay": {
      "milliseconds": 100
    }
  },

  // Telemetry and privacy settings
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },

  // Trust workspaces automatically
  "session": {
    "trust_all_worktrees": true
  },

  // Modal editing
  "vim_mode": true,

  // Typography and font sizing
  "ui_font_size": 16,
  "buffer_font_size": 15,

  // Theme configuration
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Aura Dark"
  },

  // UI clutter reduction
  "title_bar": {
    "show_onboarding_banner": true,
    "show_branch_status_icon": false,
    "show_user_picture": false
  },
  "toolbar": {
    "selections_menu": true,
    "breadcrumbs": false,
    "quick_actions": false
  },
  "scrollbar": {
    "show": "never"
  },

  // Code editor behavior
  "extend_comment_on_newline": false,

  // Disable contextual ligatures/alternates in code font
  "buffer_font_features": {
    "calt": false
  },
}
